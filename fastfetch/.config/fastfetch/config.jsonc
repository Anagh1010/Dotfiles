//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  MacOS
//
//  by Anagh

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 6
    },
    "size": {
      "binaryPrefix": "jedec"
    },
    "separator": ""
  },
  "logo": {
    "type": "small",
    "height": 4,
    "padding": {
      "top": 2,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "yellow", 
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "red",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "yellow",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "cyan",
      "folders": ["/"],
      "format": "{size-used} / {size-total}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m󰮯 \u001b[32m󰊠 \u001b[34m󰊠 \u001b[31m󰊠 \u001b[36m󰊠 \u001b[35m󰊠 \u001b[37m󰊠 \u001b[97m󰊠"
    }
  ]
}
