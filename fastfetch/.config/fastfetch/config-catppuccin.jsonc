{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10
    },
    "size": {
      "binaryPrefix": "jedec"
    },
    "separator": ""
  },
  "logo": {
  "type": "small",
  "height": 4,
  "padding": {
    "top": 2,
    "left": 2
  },
  "color": {
    "1": "#a6e3a1",
    "2": "#fab387",
    "3": "#f38ba8",
    "4": "#cba6f7",
    "5": "#89b4fa"
  }
},
  "modules": [
    "break",
    {
      "type": "os",
      "key": "os",
      "keyColor": "#f9e2af",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "ker",
      "keyColor": "#a6e3a1"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "#94e2d5"
    },
    {
      "type": "shell",
      "key": "sh",
      "keyColor": "#89b4fa",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "#f38ba8",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "up",
      "keyColor": "#a6e3a1"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "#f38ba8",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "ram",
      "keyColor": "#f9e2af",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "#94e2d5",
      "folders": [
        "/"
      ],
      "format": "{size-used} / {size-total}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;249;226;175m󰮯 \u001b[38;2;166;227;161m󰊠 \u001b[38;2;137;180;250m󰊠 \u001b[38;2;243;139;168m󰊠 \u001b[38;2;148;226;213m󰊠 \u001b[38;2;203;166;247m󰊠 \u001b[38;2;205;214;244m󰊠 \u001b[38;2;245;224;220m󰊠"
    }
  ]
}
