theme = TokyoNight
font-family = 0xProto Nerd Font Mono
#font-style = SemiLight
font-size = 22
adjust-cell-height = 20%
font-feature = liga
window-width = 100
window-height = 22
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
#mouse-scroll-multiplier = 2
#background-opacity = 0.95
